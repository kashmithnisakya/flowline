 }
+
+impl DurableBoundary.postinit {
+    self._lock = threading.RLock();
+}
+
+impl DurableBoundary.mark {
+    with self._lock {
+        self._generation += 1;
+    }
+}
+
+impl DurableBoundary.current -> int {
+    with self._lock {
